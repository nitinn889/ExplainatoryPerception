.venv/
__pycache__/
*.pyc
data/memory_store/
data/raw_sessions/*
!data/raw_sessions/.gitkeep
.pytest_cache/
.mypy_cache/
# Detector weights: ~70 MB, fetched with scripts/fetch_ssd_model.sh
models/*/*.pb
models/*/*.pbtxt
models/*/*.caffemodel
